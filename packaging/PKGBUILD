# Maintainer: nullbyte61 <nullbyte61@users.noreply.github.com>
#
# Builds Nullamp from the local checkout (run from this directory):
#     cd packaging && makepkg -si
#
# Requires the git submodules to be initialised first:
#     git submodule update --init --recursive
#
pkgname=nullamp
pkgver=0.3.0
pkgrel=1
pkgdesc="A player for Neural Amp Modeler captures (LV2/CLAP/VST3/JACK)"
arch=('x86_64' 'aarch64')
url="https://github.com/nullbyte61/nullamp"
license=('MIT')
depends=('gcc-libs')
optdepends=('jack: standalone audio'
            'carla: plugin host'
            'ardour: DAW')
makedepends=('cmake' 'git')
provides=('nullamp')

build() {
    # PKGBUILD lives in packaging/; the source tree is one level up.
    local src="$startdir/.."
    cmake -B "$srcdir/build" -S "$src" \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DNAM_DPF_BUILD_TESTS=OFF
    cmake --build "$srcdir/build" -j"$(nproc)"
}

package() {
    DESTDIR="$pkgdir" cmake --install "$srcdir/build"
    install -Dm644 "$startdir/../LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
